{% liquid
  assign corner_radius = section.settings.corner_radius | default: 16
  assign section_width_class = 'section--' | append: section.settings.section_width
%}

<div
  class="hero-carousel-wrapper spacing-style {{ section_width_class }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <hero-carousel
    class="hero-carousel"
    style="--corner-radius: {{ corner_radius }}px;"
  >
    <div class="hero-carousel__track" ref="track">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'content-slide' %}
            <div
              class="hero-carousel__slide hero-carousel__slide--content"
              style="
                --gradient-angle: {{ block.settings.gradient_angle }}deg;
                --gradient-start: {{ block.settings.gradient_color_start }};
                --gradient-end: {{ block.settings.gradient_color_end }};
                --heading-color: {{ block.settings.heading_color }};
                --subtitle-color: {{ block.settings.subtitle_color }};
                --divider-color: {{ block.settings.divider_color }};
                {% if block.settings.product_image != blank %}--product-image-url: url('{{ block.settings.product_image | image_url: width: 750 }}');{% endif %}
              "
              {{ block.shopify_attributes }}
            >
              <div class="hero-carousel__grid">
                <div class="hero-carousel__text-col">
                  <div class="hero-carousel__text-group">
                    {% if block.settings.heading != blank %}
                      <h2 class="hero-carousel__heading">
                        {{ block.settings.heading | escape }}
                      </h2>
                    {% endif %}

                    {% if block.settings.show_divider %}
                      <hr class="hero-carousel__divider">
                    {% endif %}

                    {% if block.settings.subtitle != blank %}
                      <p class="hero-carousel__subtitle">
                        {{ block.settings.subtitle | escape }}
                      </p>
                    {% endif %}
                  </div>

                  {% if block.settings.button_text != blank %}
                    <div class="hero-carousel__btn">
                      <a
                        {% if block.settings.button_url != blank %}
                          href="{{ block.settings.button_url }}"
                        {% endif %}
                        class="hero-carousel__cta"
                      >
                        {{ block.settings.button_text | escape }}
                      </a>
                    </div>
                  {% endif %}
                </div>

                {% if block.settings.product_image != blank %}
                  <div class="hero-carousel__image-col">
                    {%- assign img_sizes = '(min-width: 750px) 50vw, 100vw' -%}
                    {{
                      block.settings.product_image
                      | image_url: width: block.settings.product_image.width
                      | image_tag:
                        sizes: img_sizes,
                        widths: '375,550,750,1100,1500',
                        loading: 'eager',
                        class: 'hero-carousel__product-image',
                        alt: block.settings.product_image.alt
                    }}
                  </div>
                {% endif %}
              </div>

              <div class="hero-carousel__slide-footer">
                {% if block.settings.badge_image != blank %}
                  <div class="hero-carousel__badge">
                    {{
                      block.settings.badge_image
                      | image_url: width: block.settings.badge_image.width
                      | image_tag:
                        loading: 'eager',
                        class: 'hero-carousel__badge-image',
                        alt: block.settings.badge_image.alt
                    }}
                  </div>
                {% else %}
                  <div class="hero-carousel__badge"></div>
                {% endif %}

                <div class="hero-carousel__nav">
                  <button
                    type="button"
                    class="hero-carousel__arrow"
                    data-prev
                    aria-label="{{ 'accessibility.previous_slide' | t }}"
                  >
                    <svg width="18" height="10" viewBox="0 0 18 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M5 9L1 5M1 5L5 1M1 5L17 5" stroke="#414141" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="hero-carousel__arrow"
                    data-next
                    aria-label="{{ 'accessibility.next_slide' | t }}"
                  >
                    <svg width="18" height="10" viewBox="0 0 18 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M13 1L17 5M17 5L13 9M17 5L1 5" stroke="#414141" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>

          {% when 'image-slide' %}
            <div
              class="hero-carousel__slide hero-carousel__slide--image"
              style="--blur-amount: {{ block.settings.blur_amount }}px;"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    sizes: '100vw',
                    widths: '375,550,750,1100,1500,1780,2000',
                    loading: 'lazy',
                    class: 'hero-carousel__full-image',
                    alt: block.settings.image.alt
                }}
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </hero-carousel>
</div>

{% stylesheet %}
  .hero-carousel-wrapper {
    padding-block-start: var(--padding-block-start, 0px);
    padding-block-end: var(--padding-block-end, 0px);
  }

  .hero-carousel {
    display: block;
    position: relative;
    border-radius: var(--corner-radius, 16px);
    overflow: hidden;
  }

  .hero-carousel__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .hero-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .hero-carousel__slide {
    min-width: 100%;
    scroll-snap-align: start;
    flex-shrink: 0;
  }

  /* Content slide */
  .hero-carousel__slide--content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(
      var(--gradient-angle, 170deg),
      var(--gradient-start, #F0F0F0),
      var(--gradient-end, #E3E3E3)
    );
    padding: 32px 48px;
  }

  .hero-carousel__grid {
    display: flex;
    flex-direction: row;
    gap: 0;
    justify-content: space-between;
    align-items: center;
  }

  .hero-carousel__text-col {
    flex: 0 1 50%;
    display: flex;
    flex-direction: column;
    gap: 24px;
    justify-content: center;
  }

  .hero-carousel__text-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
  }

  .hero-carousel__heading {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 60px;
    line-height: 60px;
    letter-spacing: 0;
    color: var(--heading-color, #BC0F0F);
    margin: 0;
  }

  .hero-carousel__divider {
    width: 50%;
    height: 0;
    border: none;
    border-top: 1px solid var(--divider-color, #BC0F0F);
    margin: 0;
  }

  .hero-carousel__subtitle {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 18px;
    line-height: 24px;
    letter-spacing: -0.5px;
    color: var(--subtitle-color, #BC0F0F);
    margin: 0;
  }

  .hero-carousel__btn {
    display: flex;
  }

  .hero-carousel__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    color: #FFFFFF;
    border-radius: 28px;
    padding: 16px 28px;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 16px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .hero-carousel__cta:hover {
    opacity: 0.85;
  }

  .hero-carousel__image-col {
    flex: 0 1 50%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-carousel__product-image {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* Slide footer */
  .hero-carousel__slide-footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .hero-carousel__badge {
    flex-shrink: 0;
  }

  .hero-carousel__badge-image {
    max-height: 40px;
    width: auto;
    display: block;
  }

  /* Navigation arrows */
  .hero-carousel__nav {
    display: flex;
    gap: 2px;
    align-items: center;
    flex-shrink: 0;
  }

  .hero-carousel__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 48px;
    background-color: #F5F5F5;
    border: none;
    border-radius: 28px;
    cursor: pointer;
    padding: 12px 20px;
    transition: background-color 0.2s ease;
  }

  .hero-carousel__arrow:hover {
    background-color: #E8E8E8;
  }

  .hero-carousel__arrow:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .hero-carousel__arrow svg {
    display: block;
    flex-shrink: 0;
  }

  /* Image slide */
  .hero-carousel__slide--image {
    position: relative;
    aspect-ratio: 1484 / 965;
    overflow: hidden;
  }

  .hero-carousel__full-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(var(--blur-amount, 4px));
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .hero-carousel__slide--content {
      padding: 32px 12px 20px 12px;
      align-items: center;
      background-image: var(--product-image-url, none);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 620px;
    }

    .hero-carousel__grid {
      flex-direction: column;
      gap: 24px;
    }

    .hero-carousel__text-col {
      flex: none;
      width: 100%;
      text-align: center;
      align-items: center;
    }

    .hero-carousel__text-group {
      align-items: center;
    }

    .hero-carousel__heading {
      line-height: 48px;
      text-align: center;
    }

    .hero-carousel__divider {
      display: none;
    }

    .hero-carousel__subtitle {
      font-size: 16px;
      line-height: 20px;
      text-align: center;
    }

    .hero-carousel__btn {
      justify-content: center;
    }

    .hero-carousel__cta {
      font-size: 14px;
      line-height: 14px;
      padding: 12px 20px;
    }

    .hero-carousel__image-col {
      display: none;
    }

    .hero-carousel__badge-image {
      max-height: 28px;
    }

    .hero-carousel__arrow {
      width: 44px;
      height: 32px;
      padding: 6px 12px;
    }

    .hero-carousel__arrow svg {
      width: 15px;
      height: 8px;
    }

    .hero-carousel__slide--image {
      aspect-ratio: 954 / 620;
    }
  }
{% endstylesheet %}

<script type="module">
  import { Component } from '@theme/component';

  class HeroCarousel extends Component {
    connectedCallback() {
      super.connectedCallback();

      const prevBtns = this.querySelectorAll('[data-prev]');
      const nextBtns = this.querySelectorAll('[data-next]');

      for (const btn of prevBtns) {
        btn.addEventListener('click', this.#handlePrev.bind(this));
      }

      for (const btn of nextBtns) {
        btn.addEventListener('click', this.#handleNext.bind(this));
      }
    }

    #handlePrev() {
      const track = this.querySelector('.hero-carousel__track');
      if (!track) return;
      track.scrollBy({ left: -track.offsetWidth, behavior: 'smooth' });
    }

    #handleNext() {
      const track = this.querySelector('.hero-carousel__track');
      if (!track) return;
      track.scrollBy({ left: track.offsetWidth, behavior: 'smooth' });
    }
  }

  if (!customElements.get('hero-carousel')) {
    customElements.define('hero-carousel', HeroCarousel);
  }
</script>

{% schema %}
{
  "name": "t:names.hero_carousel",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "number",
      "id": "corner_radius",
      "label": "Corner radius",
      "default": 16
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "t:options.page_width" },
        { "value": "full-width", "label": "t:options.full_width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "header",
      "content": "t:names.spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "content-slide",
      "name": "t:names.content_slide",
      "settings": [
        {
          "type": "header",
          "content": "t:content.heading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color",
          "default": "#BC0F0F"
        },
        {
          "type": "header",
          "content": "Subtitle"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "color",
          "id": "subtitle_color",
          "label": "Subtitle color",
          "default": "#BC0F0F"
        },
        {
          "type": "header",
          "content": "Divider"
        },
        {
          "type": "checkbox",
          "id": "show_divider",
          "label": "Show divider",
          "default": true
        },
        {
          "type": "color",
          "id": "divider_color",
          "label": "Divider color",
          "default": "#BC0F0F"
        },
        {
          "type": "header",
          "content": "t:content.buttons"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "t:content.images"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product image"
        },
        {
          "type": "image_picker",
          "id": "badge_image",
          "label": "Badge image"
        },
        {
          "type": "header",
          "content": "t:content.background"
        },
        {
          "type": "color",
          "id": "gradient_color_start",
          "label": "Gradient start",
          "default": "#F0F0F0"
        },
        {
          "type": "color",
          "id": "gradient_color_end",
          "label": "Gradient end",
          "default": "#E3E3E3"
        },
        {
          "type": "number",
          "id": "gradient_angle",
          "label": "Gradient angle",
          "default": 170
        }
      ]
    },
    {
      "type": "image-slide",
      "name": "t:names.image_slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:content.image"
        },
        {
          "type": "range",
          "id": "blur_amount",
          "label": "Blur amount",
          "min": 0,
          "max": 20,
          "step": 1,
          "default": 4,
          "unit": "px"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:names.hero_carousel",
      "blocks": [
        {
          "type": "content-slide"
        },
        {
          "type": "image-slide"
        }
      ]
    }
  ]
}
{% endschema %}
