<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
>
  <div
    class="learn spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- if section.settings.heading != blank -%}
      <div class="learn__heading">{{ section.settings.heading }}</div>
    {%- endif -%}

    <hr class="learn__divider">

    {%- if section.settings.subtitle != blank -%}
      <p class="learn__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    {%- assign video_blocks = section.blocks | where: 'type', 'video-card' -%}
    {%- if video_blocks.size > 0 -%}
      <div class="learn__category">
        {%- if section.settings.watch_title != blank -%}
          <div class="learn__category-title">{{ section.settings.watch_title | escape }}</div>
        {%- endif -%}
        <div class="learn__carousel">
          {%- for block in video_blocks -%}
            <div class="learn__video-card" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 560 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 280 }} 280w,
                    {{ block.settings.image | image_url: width: 375 }} 375w,
                    {{ block.settings.image | image_url: width: 560 }} 560w
                  "
                  sizes="(min-width: 990px) 280px, 280px"
                  alt="{{ block.settings.title | escape }}"
                  class="learn__video-image"
                  width="280"
                  height="380"
                  loading="lazy"
                >
              {%- else -%}
                <div class="learn__video-placeholder"></div>
              {%- endif -%}

              <div class="learn__mute-icon">
                <img
                  src="{{ 'volume-mute-solid.svg' | asset_url }}"
                  alt=""
                  width="24"
                  height="24"
                >
              </div>

              <div class="learn__video-overlay">
                {%- if block.settings.url != blank -%}
                  <a href="{{ block.settings.url }}" class="learn__video-overlay-link">
                    <span class="learn__video-title">{{ block.settings.title | escape }}</span>
                    <img
                      src="{{ 'frame-308.svg' | asset_url }}"
                      alt=""
                      width="20"
                      height="20"
                      class="learn__play-icon"
                    >
                  </a>
                {%- else -%}
                  <span class="learn__video-title">{{ block.settings.title | escape }}</span>
                  <img
                    src="{{ 'frame-308.svg' | asset_url }}"
                    alt=""
                    width="20"
                    height="20"
                    class="learn__play-icon"
                  >
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- assign article_blocks = section.blocks | where: 'type', 'article-card' -%}
    {%- if article_blocks.size > 0 -%}
      <div class="learn__category">
        {%- if section.settings.articles_title != blank -%}
          <div class="learn__category-title">{{ section.settings.articles_title | escape }}</div>
        {%- endif -%}
        <div class="learn__carousel">
          {%- for block in article_blocks -%}
            <div class="learn__article-card" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 560 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 280 }} 280w,
                    {{ block.settings.image | image_url: width: 375 }} 375w,
                    {{ block.settings.image | image_url: width: 560 }} 560w
                  "
                  sizes="(min-width: 990px) 280px, 280px"
                  alt="{{ block.settings.title | escape }}"
                  class="learn__card-image"
                  width="280"
                  height="200"
                  loading="lazy"
                >
              {%- else -%}
                <div class="learn__card-image-placeholder"></div>
              {%- endif -%}

              <div class="learn__article-content">
                <div class="learn__card-meta">
                  {%- if block.settings.category != blank -%}
                    <span class="learn__card-category">{{ block.settings.category | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.read_time != blank -%}
                    <span class="learn__card-read-time">{{ block.settings.read_time | escape }}</span>
                  {%- endif -%}
                </div>

                {%- if block.settings.title != blank -%}
                  <p class="learn__card-title">{{ block.settings.title | escape }}</p>
                {%- endif -%}

                {%- if block.settings.url != blank -%}
                  <div class="learn__card-cta">
                    <a href="{{ block.settings.url }}" class="learn__card-link">{{ 'sections.learn.read_more' | t }}</a>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.button_text != blank -%}
      <div class="learn__cta">
        <a
          {%- if section.settings.button_url != blank %} href="{{ section.settings.button_url }}"{% endif %}
          class="learn__button"
        >
          {{- section.settings.button_text | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .learn {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-inline: 12px;
  }

  .learn__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 500;
    font-size: 28px;
    line-height: 36px;
    color: #767676;
    margin: 0;
  }

  .learn__heading strong {
    font-weight: 700;
  }

  .learn__divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0;
    width: 100%;
  }

  .learn__subtitle {
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: -0.5px;
    color: #767676;
    margin: 0;
  }

  .learn__category {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0 8px;
  }

  .learn__category-title {
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: 400;
    font-size: 14px;
    line-height: 14px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: #767676;
    padding: 16px 0;
  }

  .learn__carousel {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .learn__carousel::-webkit-scrollbar {
    display: none;
  }

  .learn__video-card {
    flex: 0 0 280px;
    height: 380px;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    scroll-snap-align: start;
  }

  .learn__video-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .learn__video-placeholder {
    width: 100%;
    height: 100%;
    background-color: #767676;
    opacity: 0.2;
  }

  .learn__mute-icon {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 24px;
    height: 24px;
  }

  .learn__mute-icon img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .learn__video-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px 20px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .learn__video-overlay-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    width: 100%;
  }

  .learn__video-title {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 700;
    font-size: 18px;
    line-height: 20px;
    color: #FFFFFF;
    flex: 1;
  }

  .learn__play-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .learn__article-card {
    flex: 0 0 280px;
    scroll-snap-align: start;
    overflow: hidden;
  }

  .learn__card-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }

  .learn__card-image-placeholder {
    width: 100%;
    height: 200px;
    border-radius: 8px;
    background-color: #767676;
    opacity: 0.2;
  }

  .learn__article-content {
    padding: 16px 4px 8px 4px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .learn__card-meta {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .learn__card-category {
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: 500;
    font-size: 12px;
    line-height: 14px;
    color: #414141;
  }

  .learn__card-read-time {
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: 500;
    font-size: 12px;
    line-height: 14px;
    color: #A0A0A0;
  }

  .learn__card-title {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 700;
    font-size: 18px;
    line-height: 20px;
    color: #414141;
    margin: 0;
  }

  .learn__card-cta {
    padding: 4px 0;
  }

  .learn__card-link {
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: 500;
    font-size: 14px;
    line-height: 18px;
    color: #414141;
    text-decoration: underline;
  }

  .learn__card-link:hover {
    opacity: 0.7;
  }

  .learn__cta {
    width: 100%;
  }

  .learn__button {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: 400;
    font-size: 14px;
    line-height: 14px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    text-decoration: none;
    color: #000000;
    background: transparent;
    border: 2px solid #000000;
    border-radius: 28px;
    padding: 12px 20px;
    cursor: pointer;
    white-space: nowrap;
    width: 100%;
  }

  .learn__button:hover {
    background: #000000;
    color: #FFFFFF;
  }

  @media screen and (min-width: 990px) {
    .learn {
      gap: 20px;
      padding-inline: 0;
    }

    .learn__heading {
      font-size: 48px;
      line-height: 52px;
    }

    .learn__subtitle {
      font-size: 18px;
      line-height: 24px;
    }

    .learn__category-title {
      font-size: 16px;
      line-height: 16px;
    }

    .learn__carousel {
      gap: 24px;
      overflow-x: visible;
      scroll-snap-type: none;
    }

    .learn__video-card {
      flex: 1 1 0;
    }

    .learn__video-title {
      font-size: 20px;
      line-height: 24px;
    }

    .learn__article-card {
      flex: 1 1 0;
    }

    .learn__card-category {
      font-size: 14px;
      line-height: 16px;
    }

    .learn__card-read-time {
      font-size: 14px;
      line-height: 16px;
    }

    .learn__card-title {
      font-size: 20px;
      line-height: 24px;
    }

    .learn__cta {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
