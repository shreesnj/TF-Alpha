{%- liquid
  assign search_href = section.settings.search_url
  if search_href == blank
    assign search_href = routes.search_url
  endif
-%}

<div class="spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="ask-me">
    <div class="ask-me__container color-{{ section.settings.color_scheme }}">
      <div class="ask-me__content">
        <h2 class="ask-me__heading">{{ section.settings.heading | escape }}</h2>
        <a href="{{ search_href }}" class="ask-me__field">
          <span class="ask-me__field-inner">
            <img
              src="{{ 'book-open-solid.svg' | asset_url }}"
              alt=""
              class="ask-me__field-icon"
              width="28"
              height="28"
              loading="lazy"
            >
            <span class="ask-me__field-text">{{ section.settings.placeholder_text | escape }}</span>
          </span>
          <span class="ask-me__field-button">{{ section.settings.button_text | escape }}</span>
        </a>
      </div>

      {%- if section.settings.expert_title != blank or section.settings.expert_image != blank -%}
        <div class="ask-me__expert">
          {%- if section.settings.expert_image != blank -%}
            <div class="ask-me__expert-image-wrapper">
              <img
                src="{{ section.settings.expert_image | image_url: width: 144 }}"
                alt="{{ section.settings.expert_title | escape }}"
                class="ask-me__expert-image"
                width="72"
                height="72"
                loading="lazy"
              >
              {%- if section.settings.show_expert_badge -%}
                <span class="ask-me__expert-badge">
                  <img src="{{ 'check-solid.svg' | asset_url }}" alt="" width="8" height="8">
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="ask-me__expert-text">
            {%- if section.settings.expert_title != blank -%}
              <p class="ask-me__expert-title">{{ section.settings.expert_title | escape }}</p>
            {%- endif -%}
            {%- if section.settings.expert_description != blank -%}
              <p class="ask-me__expert-description">{{ section.settings.expert_description | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .ask-me {
    padding-inline: 12px;
  }

  .ask-me__container {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-radius: 16px;
    overflow: hidden;
    background-color: var(--color-background);
  }

  .ask-me__content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px 20px;
    align-items: center;
  }

  .ask-me__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 700;
    font-size: 24px;
    line-height: 32px;
    letter-spacing: 0;
    color: var(--color-foreground);
    text-align: center;
    margin: 0;
    word-break: break-word;
  }

  .ask-me__field {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 24px;
    background-color: #ffffff;
    border: 2px solid #f5f5f5;
    text-decoration: none;
    width: 100%;
    box-sizing: border-box;
  }

  .ask-me__field:hover {
    border-color: #e0e0e0;
  }

  .ask-me__field-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }

  .ask-me__field-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    display: block;
  }

  .ask-me__field-text {
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: 500;
    font-size: 14px;
    line-height: 18px;
    letter-spacing: 0;
    color: #767676;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ask-me__field-button {
    display: none;
  }

  .ask-me__expert {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background-color: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    justify-content: center;
  }

  .ask-me__expert-image-wrapper {
    position: relative;
    flex-shrink: 0;
  }

  .ask-me__expert-image {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .ask-me__expert-badge {
    position: absolute;
    bottom: 0;
    right: -2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: #414141;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ask-me__expert-badge img {
    width: 8px;
    height: 8px;
    display: block;
  }

  .ask-me__expert-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ask-me__expert-title {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 700;
    font-size: 14px;
    line-height: 18px;
    letter-spacing: 0;
    color: var(--color-foreground);
    margin: 0;
  }

  .ask-me__expert-description {
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: 500;
    font-size: 14px;
    line-height: 18px;
    letter-spacing: 0;
    color: var(--color-foreground);
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .ask-me {
      padding-inline: 16px;
    }

    .ask-me__container {
      flex-direction: row;
    }

    .ask-me__content {
      flex: 1;
      padding: 28px 40px 32px 40px;
      min-width: 0;
    }

    .ask-me__heading {
      font-size: 32px;
      line-height: 40px;
      text-align: start;
      width: 100%;
    }

    .ask-me__field {
      padding: 8px;
      border-radius: 32px;
      height: 48px;
      box-sizing: border-box;
    }

    .ask-me__field-inner {
      padding: 0 8px;
    }

    .ask-me__field-icon {
      width: 28px;
      height: 28px;
    }

    .ask-me__field-text {
      font-size: 16px;
      line-height: 20px;
      color: #414141;
    }

    .ask-me__field-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 28px;
      background-color: #000000;
      color: #ffffff;
      padding: 8px 16px;
      font-family: var(--font-body--family);
      font-style: var(--font-body--style);
      font-weight: 400;
      font-size: 14px;
      line-height: 16px;
      letter-spacing: 0.75px;
      text-transform: uppercase;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .ask-me__expert {
      flex: 0 0 auto;
      padding: 0 32px;
      justify-content: flex-start;
    }

    .ask-me__expert-image {
      width: 72px;
      height: 72px;
    }

    .ask-me__expert-badge {
      display: none;
    }

    .ask-me__expert-text {
      gap: 4px;
    }

    .ask-me__expert-title {
      font-size: 16px;
      line-height: 20px;
    }

    .ask-me__expert-description {
      font-size: 16px;
      line-height: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.ask_me",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Ask me anything about cardiovascular health"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "t:settings.placeholder_text",
      "default": "How does blood flow support energy?"
    },
    {
      "type": "url",
      "id": "search_url",
      "label": "t:settings.search_url"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:settings.button_text",
      "default": "GO"
    },
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "image_picker",
      "id": "expert_image",
      "label": "t:settings.expert_image"
    },
    {
      "type": "text",
      "id": "expert_title",
      "label": "t:settings.expert_title",
      "default": "Approved by experts"
    },
    {
      "type": "text",
      "id": "expert_description",
      "label": "t:settings.expert_description",
      "default": "Get answers backed by research from Humann's Chief Cardiologist."
    },
    {
      "type": "checkbox",
      "id": "show_expert_badge",
      "label": "t:settings.show_badge",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "t:names.ask_me"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
