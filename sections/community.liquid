<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
>
  <div
    class="community spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="community__header">
      {%- if section.settings.heading != blank -%}
        <div class="community__heading">{{ section.settings.heading }}</div>
      {%- endif -%}

      {%- if section.settings.show_divider -%}
        <hr class="community__divider">
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="community__subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.stat_number != blank or section.settings.stat_label != blank -%}
        <div class="community__stat">
          {%- if section.settings.stat_number != blank -%}
            <span class="community__stat-number">{{ section.settings.stat_number | escape }}</span>
          {%- endif -%}
          {%- if section.settings.stat_label != blank -%}
            <span class="community__stat-label">{{ section.settings.stat_label | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="community__grid">
        {%- for block in section.blocks -%}
          <div class="community__card" {{ block.shopify_attributes }}>
            <div class="community__card-image">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 768 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 375 }} 375w,
                    {{ block.settings.image | image_url: width: 550 }} 550w,
                    {{ block.settings.image | image_url: width: 768 }} 768w
                  "
                  sizes="(min-width: 990px) 280px, calc(50vw - 22px)"
                  alt="{{ block.settings.username | default: '' | escape }}"
                  class="community__card-img"
                  width="280"
                  height="502"
                  loading="lazy"
                >
              {%- else -%}
                <div class="community__card-placeholder"></div>
              {%- endif -%}

              {%- if block.settings.video_url != blank -%}
                <a
                  href="{{ block.settings.video_url }}"
                  class="community__play-btn"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="{{ block.settings.username | escape }}"
                >
                  <img
                    src="{{ 'frame-308.svg' | asset_url }}"
                    alt=""
                    width="10"
                    height="13"
                    class="community__play-icon"
                  >
                </a>
              {%- else -%}
                <span class="community__play-btn" aria-hidden="true">
                  <img
                    src="{{ 'frame-308.svg' | asset_url }}"
                    alt=""
                    width="10"
                    height="13"
                    class="community__play-icon"
                  >
                </span>
              {%- endif -%}
            </div>

            {%- if block.settings.username != blank -%}
              <p class="community__username">{{ block.settings.username | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .community {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
    padding-inline: 16px;
  }

  .community__header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    position: relative;
  }

  .community__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 400;
    font-size: 32px;
    line-height: 36px;
    letter-spacing: -1px;
    color: var(--color-foreground);
    margin: 0;
    order: 1;
  }

  .community__heading strong {
    font-weight: 700;
  }

  .community__divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0;
    width: 100%;
    order: 2;
  }

  .community__subtitle {
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: 500;
    font-size: 18px;
    line-height: 20px;
    letter-spacing: 0;
    color: var(--color-foreground);
    margin: 0;
    order: 3;
  }

  .community__stat {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    order: 4;
  }

  .community__stat-number {
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: 700;
    font-size: 24px;
    line-height: 32px;
    letter-spacing: 0;
    color: var(--color-primary);
  }

  .community__stat-label {
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: -0.5px;
    color: var(--color-primary);
  }

  .community__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    width: 100%;
  }

  .community__card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-content: center;
  }

  .community__card-image {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 175 / 265;
  }

  .community__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .community__card-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-foreground);
    opacity: 0.1;
  }

  .community__play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 46px;
    height: 46px;
    border-radius: 23px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    text-decoration: none;
  }

  .community__play-icon {
    width: 10px;
    height: 13px;
    display: block;
  }

  .community__username {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 400;
    font-size: 18px;
    line-height: 25px;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;
  }

  @media screen and (min-width: 990px) {
    .community {
      gap: 20px;
      padding-inline: 0;
    }

    .community__header {
      gap: 20px;
    }

    .community__heading {
      font-size: 48px;
      line-height: 52px;
      order: unset;
    }

    .community__divider {
      order: unset;
    }

    .community__subtitle {
      font-size: 20px;
      line-height: 24px;
      order: unset;
    }

    .community__stat {
      position: absolute;
      top: 0;
      right: 0;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      text-align: center;
      order: unset;
    }

    .community__stat-number {
      font-size: 48px;
      line-height: 52px;
    }

    .community__stat-label {
      font-size: 14px;
      line-height: 16px;
      letter-spacing: 0;
    }

    .community__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }

    .community__card {
      gap: 5px;
    }

    .community__card-image {
      aspect-ratio: 280 / 502;
    }

    .community__play-btn {
      width: 48px;
      height: 48px;
      border-radius: 24px;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.community",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "<p>The <strong>Humann community</strong>, in motion.</p>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:settings.subheading",
      "default": "More than a product. A community of people focused on feeling better."
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "t:settings.stat_number",
      "default": "6.5K"
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "t:settings.stat_label",
      "default": "Active monthly subscribers"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:settings.show_divider",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "video-card",
      "name": "t:names.video_card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "t:settings.video_url"
        },
        {
          "type": "text",
          "id": "username",
          "label": "t:settings.username"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:names.community",
      "blocks": [
        {
          "type": "video-card",
          "settings": {
            "username": "@velmacan"
          }
        },
        {
          "type": "video-card",
          "settings": {
            "username": "@reillytris"
          }
        },
        {
          "type": "video-card",
          "settings": {
            "username": "@_cmfree"
          }
        },
        {
          "type": "video-card",
          "settings": {
            "username": "@tha_one08"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
