            "stat_value": "78%",
            "stat_description": "of customers report improved energy levels, after completing their first 90-day routine.",
            "icon_asset": "icon-2.svg",
            "button_text": "SHOP Metabolic"
          }
        },
        {
          "type": "key-card",
          "settings": {
            "number": "3",
